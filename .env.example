# Copy to .env and fill in. NEVER commit .env

ENVIRONMENT=dev
APP_NAME=Enterprise Knowledge Platform

# Database, cache, search
DATABASE_URL=postgresql+psycopg://ekp:ekp@localhost:5432/ekp
REDIS_URL=redis://localhost:6379/0
OPENSEARCH_URL=http://localhost:9200

# Auth. JWT_SECRET kam se kam 32 random characters ka ho.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256

# Browser frontend ka origin (JSON list)
CORS_ORIGINS=["http://localhost:5173"]

# Retrieval aur generation
EMBEDDING_DIMENSION=64
LLM_PROVIDER=fake
LLM_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=